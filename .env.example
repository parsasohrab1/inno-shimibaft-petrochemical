# امنیت — پیش از استقرار واقعی حتماً تغییر دهید
SECRET_KEY=change-me-in-production
TOKEN_TTL_MINUTES=480
# رمز کاربر نمونه (Demo) — فقط برای محیط توسعه/دمو روی لوکال‌هاست
DEMO_PASSWORD=Demo@12345

# مسیر داده (پایگاه‌داده SQLite و فایل‌های موقت)
DATA_DIR=./data
AUTO_SEED=1

# اتصال به DCS / Historian واقعی — در این اسکلت پیاده‌سازی نشده (ماژول ۱)
# این مقادیر فقط جای‌نگه‌دار هستند؛ هیچ درخواست واقعی به آن‌ها ارسال نمی‌شود.
DCS_ENDPOINT=
HISTORIAN_ENDPOINT=
LAB_LIMS_ENDPOINT=

# آدرس فرانت‌اند برای توسعه محلی (CORS)
FRONTEND_ORIGIN=http://127.0.0.1:5173
